# Example systemd unit to keep Recipe Box running and start it on boot.
#
# 1. Copy the whole recipe-site folder onto your server, e.g. to
#    /opt/recipe-box (adjust the paths below if you put it elsewhere).
# 2. Run `npm install --omit=dev` inside that folder once.
# 3. Copy this file to /etc/systemd/system/recipe-box.service
#    (drop the .example suffix)
# 4. sudo systemctl daemon-reload
# 5. sudo systemctl enable --now recipe-box
# 6. Check status/logs: sudo systemctl status recipe-box
#                        sudo journalctl -u recipe-box -f

[Unit]
Description=Recipe Box - self-hosted recipe site
After=network.target

[Service]
Type=simple
# Change this to wherever you place the app folder:
WorkingDirectory=/opt/recipe-box
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=3
Environment=PORT=3000
Environment=NODE_ENV=production

# Run as a dedicated, unprivileged user if you can (recommended):
# User=recipebox
# Group=recipebox

[Install]
WantedBy=multi-user.target
